{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": [".output", ".wxt", "node_modules"],
  "rules": {
    // 全案的讀寫刻意序列化過節流器（design.md 6.4／8.3）：平行化正是要避免的事，不是漏改。
    "no-await-in-loop": "off",
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": "warn",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
